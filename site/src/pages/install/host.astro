---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Install the host | Surf" description="Install the Surf host on Windows, macOS, or Linux.">
  <div class="wrap">
    <section class="page-lead">
      <h1>Install the host</h1>
      <p class="deck">
        The host runs Chromium and talks to clients. Download a release build
        or compile from source.
      </p>
      <ul class="cta-row">
        <li><a class="cta cta-primary" href="https://github.com/seg6/surf/releases/latest">Downloads</a></li>
        <li><a class="cta cta-secondary" href={`${base}docs/guide/install-host/`}>Full guide</a></li>
      </ul>
    </section>

    <section class="section">
      <h2>Foreground</h2>
      <pre class="code">./surf serve
surf status
surf pair</pre>
      <p>TLS on port <code>18080</code> by default. Keep <code>SURF_HOME</code> across updates.</p>
    </section>

    <section class="section">
      <h2>Next</h2>
      <ul class="doc-links">
        <li>
          <a href={`${base}install/ios/`}>iOS client</a>
          <span>Cydia / Sileo source on a jailbroken device.</span>
        </li>
        <li>
          <a href={`${base}install/desktop/`}>Linux client</a>
          <span>Desktop client for Linux.</span>
        </li>
        <li>
          <a href={`${base}docs/guide/pairing/`}>Pairing</a>
          <span>Invite a device and match the six words.</span>
        </li>
      </ul>
    </section>
  </div>
</Base>
