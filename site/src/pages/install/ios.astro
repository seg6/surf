---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const source = 'https://seg6.space/surf/';
---
<Base title="iOS client | Surf" description="Install the Surf iOS client from Cydia, Sileo, or a .deb.">
  <div class="wrap">
    <section class="page-lead">
      <h1>iOS client</h1>
      <p class="deck">
        For jailbroken iPhone, iPod touch, and iPad on iOS 6.0-14.8.1 (rootful
        install). Pair it with a Surf host on your computer.
      </p>
    </section>

    <section class="apt">
      <h2>Add the source</h2>
      <p class="source">{source}</p>
      <ul class="cta-row">
        <li>
          <a
            class="cta cta-primary"
            href={`cydia://url/https://cydia.saurik.com/api/share#?source=${source}`}
          >Open in Cydia</a>
        </li>
        <li>
          <a class="cta cta-secondary" href={`sileo://source/${source}`}>Open in Sileo</a>
        </li>
        <li>
          <a class="cta cta-secondary" href={`${base}__SURF_PACKAGE_PATH__`}>Download .deb</a>
        </li>
      </ul>
      <p class="meta">
        In Cydia: Sources -> Edit -> Add, paste the URL above, then install Surf.
        In Sileo: Sources -> +, same URL. Respring if the icon is missing after
        install.
      </p>
      <!--SURF_PACKAGE_IDENTITY-->
    </section>

    <section class="section">
      <h2>Next</h2>
      <ul class="doc-links">
        <li>
          <a href={`${base}install/host/`}>Install the host</a>
          <span>Needed on the computer before you can pair.</span>
        </li>
        <li>
          <a href={`${base}docs/guide/pairing/`}>Pairing</a>
          <span>QR or code, then match the six words.</span>
        </li>
        <li>
          <a href={`${base}docs/clients/ios/`}>Supported devices</a>
          <span>Models and OS ranges.</span>
        </li>
      </ul>
    </section>
  </div>
</Base>
