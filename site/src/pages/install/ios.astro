---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const source = 'https://seg6.space/surf/';
---
<Base title="iOS client | Surf" description="Install the Surf iOS client from Cydia, Sileo, or a .deb.">
  <div class="wrap">
    <section class="page-lead">
      <h1>iOS client</h1>
      <p class="deck">
        This is for jailbroken iPhones, iPod touches and iPads running iOS 6.0
        through 14.8.1, with a rootful jailbreak. Once it's installed, pair it
        with the Surf host on your computer.
      </p>
    </section>

    <section class="apt">
      <h2>Add the source</h2>
      <p class="source">{source}</p>
      <ul class="cta-row">
        <li>
          <a
            class="cta cta-primary"
            href={`cydia://url/https://cydia.saurik.com/api/share#?source=${source}`}
          >Open in Cydia</a>
        </li>
        <li>
          <a class="cta cta-secondary" href={`sileo://source/${source}`}>Open in Sileo</a>
        </li>
        <li>
          <a class="cta cta-secondary" href={`${base}__SURF_PACKAGE_PATH__`}>Download .deb</a>
        </li>
      </ul>
      <p class="meta">
        In Cydia, open Sources, tap Edit, then Add, paste the URL above and
        install Surf. In Sileo, open Sources, tap the plus button and paste the
        same URL. If the icon doesn't show up after installing, respring.
      </p>
      <!--SURF_PACKAGE_IDENTITY-->
    </section>

    <section class="section">
      <h2>Next</h2>
      <ul class="doc-links">
        <li>
          <a href={`${base}install/host/`}>Install the host</a>
          <span>You need this running on your computer before you can pair.</span>
        </li>
        <li>
          <a href={`${base}docs/guide/pairing/`}>Pairing</a>
          <span>Scan the QR code or type the code, then check the six words.</span>
        </li>
        <li>
          <a href={`${base}docs/clients/ios/`}>Supported devices</a>
          <span>Which models and iOS versions work.</span>
        </li>
      </ul>
    </section>
  </div>
</Base>
