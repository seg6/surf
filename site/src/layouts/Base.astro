---
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Surf runs Chromium on your computer and streams it to a native app on another device, so old hardware can browse the modern web.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}#how`, label: 'How it works' },
  { href: `${base}#clients`, label: 'Clients' },
  { href: `${base}#specs`, label: 'Requirements' },
  { href: `${base}#download`, label: 'Download' },
  { href: `${base}docs/`, label: 'Documentation' },
  { href: 'https://github.com/seg6/surf', label: 'GitHub' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}surf-icon-64.png`} />
    <link rel="apple-touch-icon" href={`${base}surf-icon-128.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&family=Source+Code+Pro:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="topbar">
      <nav class="nav" aria-label="Main">
        <div class="nav-row">
          <a class="nav-home" href={base} aria-label="Surf home"><img src={`${base}surf-icon-64.png`} alt="" width="22" height="22" /></a>
          {nav.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
        </div>
      </nav>
    </div>
    <slot />
    <footer class="foot">
      <div class="foot-inner">
        <span class="foot-note">Surf is open source under the MIT license.</span>
        <nav class="foot-nav" aria-label="Footer">
          <a href="https://github.com/seg6/surf/blob/main/CHANGELOG.md">Changelog</a>
          <a href="https://github.com/seg6/surf/issues">Report a problem</a>
          <a href="https://ko-fi.com/seg6_">Support on Ko-fi</a>
          <a href="https://github.com/seg6/surf">Source code</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
