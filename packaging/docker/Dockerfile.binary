FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      chromium \
      fonts-liberation \
      fonts-noto-color-emoji \
      fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

COPY surf /usr/local/bin/surf
RUN chmod 0755 /usr/local/bin/surf \
    && mkdir -p /data/surf /data/profile /data/downloads /data/uploads

ENV SURF_HOME=/data/surf \
    PROFILE=/data/profile \
    DOWNLOADS=/data/downloads \
    UPLOADS=/data/uploads \
    CHROME=/usr/bin/chromium \
    PORT=8080

VOLUME ["/data/surf", "/data/profile", "/data/downloads", "/data/uploads"]
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/surf", "serve"]
